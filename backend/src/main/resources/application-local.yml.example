# 이 파일을 application-local.yml 로 복사해서 본인 값으로 채우세요.
# application-local.yml 은 .gitignore 대상입니다 — 절대 커밋하지 마세요.
spring:
  datasource:
    username: root
    password: 여기에_MySQL_비밀번호

app:
  jwt:
    secret: 아무거나_64바이트_이상의_랜덤_문자열_1234567890_abcdefghijklmnop
  tour-api:
    # 공공데이터포털 > 마이페이지 > 활용신청 상세 > 일반 인증키
    service-key: 여기에_TourAPI_인증키
