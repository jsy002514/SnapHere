#!/bin/sh
#
# Gradle Wrapper 실행 스크립트 (간소화 버전)
#
# 공식 gradlew 는 JAVA_HOME 탐색·심볼릭링크 추적·cygwin 대응 등이 들어가 250줄이 넘습니다.
# 로컬 개발에는 아래로 충분합니다. scripts/setup.sh 를 실행하면 공식 버전으로 교체됩니다.
#
set -e

DIR=$(cd "$(dirname "$0")" && pwd)
WRAPPER_JAR="$DIR/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "gradle-wrapper.jar 가 없습니다." >&2
  echo "프로젝트 루트에서 아래를 먼저 실행하세요:" >&2
  echo "  bash scripts/setup.sh" >&2
  exit 1
fi

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD=java
fi

if ! command -v "$JAVACMD" > /dev/null 2>&1; then
  echo "java 를 찾을 수 없습니다. JDK 17 을 설치하고 JAVA_HOME 을 설정하세요." >&2
  exit 1
fi

exec "$JAVACMD" $JAVA_OPTS $GRADLE_OPTS \
  -classpath "$WRAPPER_JAR" \
  org.gradle.wrapper.GradleWrapperMain "$@"
