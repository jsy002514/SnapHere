# SnapHere 운영 환경변수 — 서버의 ~/snaphere/.env 로 복사해서 값을 채운다
#
#   cp .env.example .env
#   nano .env
#   chmod 600 .env
#
# ⚠ 이 파일(.env.example)은 저장소에 올라간다. 실제 값을 여기 쓰지 말 것.
#   .env 는 .gitignore 에 걸려 있으니 서버에만 존재한다.
#
# ⚠ 저장소가 public 이다. 서버 IP·도메인·키를 이 파일에 절대 넣지 말 것.
#   배포에 필요한 서버 주소는 GitHub Secrets(SERVER_HOST)에만 둔다.
#
# 이름이 application.yml 이 읽는 것과 정확히 맞아야 한다. 예를 들어
# JWT_SECRET 이나 GOOGLE_CLIENT_ID 로 쓰면 바인딩되지 않고 조용히 빈 값이 된다.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# 컨테이너 안에서만 접근한다(포트를 밖으로 열지 않음). 그래도 비밀번호는
# 길게 둔다 — 앱 컨테이너가 뚫렸을 때의 2차 방어선이다.
#   openssl rand -base64 24
POSTGRES_DB=snaphere
POSTGRES_USER=snaphere
POSTGRES_PASSWORD=

# ── 인증 ──────────────────────────────────────────────────────────────────
# HS256 서명 키. 최소 32바이트. 이 값이 새면 누구나 아무 사용자의
# 액세스 토큰을 위조할 수 있다.
#   openssl rand -base64 48
SNAPHERE_JWT_SECRET=

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 의 OAuth 클라이언트 ID.
# 형식: 000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=

# ── 미디어 (S3) ───────────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
# S3 PutObject/GetObject 만 가진 전용 IAM 사용자로 발급할 것.
# 루트 키나 AdministratorAccess 키를 쓰지 않는다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_S3_BUCKET=
# 이미지를 서비스할 공개 주소. CloudFront 를 쓰면 그 배포 도메인,
# 아니면 https://<버킷>.s3.<리전>.amazonaws.com
MEDIA_PUBLIC_BASE_URL=

# ── 외부 API ──────────────────────────────────────────────────────────────
# 공공데이터포털 TourAPI 서비스 키 (docs/TourAPI 연동 목록 참고)
TOUR_API_SERVICE_KEY=
# Google Geocoding 용. 비워 두면 역지오코딩이 동작하지 않는다.
GOOGLE_MAPS_API_KEY=

# ── 공유 링크 (CMU-020, CMU-021) ──────────────────────────────────────────
# 게시글 공유 URL 의 베이스. 앱이 설치돼 있으면 같은 주소가 앱으로 열린다.
SNAPHERE_SHARE_BASE_URL=https://snaphere.app

# ── 푸시 (선택) ───────────────────────────────────────────────────────────
# Firebase 서비스 계정 JSON 의 컨테이너 내부 경로.
# 비워 두면 푸시 발송만 로그로 떨어지고, 알림 생성·알림함은 정상 동작한다.
# 쓰려면 키 파일을 서버의 ~/snaphere/secrets/ 에 두고
# docker-compose.yml 의 app.volumes 주석을 해제한다.
# SNAPHERE_FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json
